# NanoQuiz backend environment variables.
# Copy to backend/.env and fill in real values (never commit .env files).

# Port the Express server listens on. Optional — defaults to 3000.
PORT=3000

# Origin of the frontend, used for CORS (REQUIRED). Must match exactly,
# including the port. Dev: http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 web client ID (REQUIRED). Must match the `aud` claim of the
# ID tokens sent to POST /api/auth/google.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Secret used to sign app JWTs (REQUIRED). Use a long random string.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated admin email addresses (REQUIRED). Example:
# admin@example.com,owner@example.com
ADMIN_EMAILS=

# Path to the SQLite database file. Optional — defaults to
# backend/data/nanoquiz.sqlite (created at boot if missing).
# DB_PATH=backend/data/nanoquiz.sqlite

# Optional comma-separated email domains allowed to sign in (e.g. example.com).
# When unset, any valid Google account may sign in (local dev only).
# RESTRICT_DOMAIN=example.com
