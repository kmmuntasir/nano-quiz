# NanoQuiz frontend environment variables.
# Copy to frontend/.env and fill in real values (never commit .env files).

# Base URL of the NanoQuiz backend API. The browser calls this directly, so it
# must be reachable from the client (nginx reverse-proxies /api in production).
VITE_API_BASE_URL=http://localhost:3000/api

# Google OAuth 2.0 web client ID (required). Must match the `aud` claim of the
# ID token sent to POST /api/auth/google. Register http://localhost:5173 as an
# authorized JavaScript origin in the Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com